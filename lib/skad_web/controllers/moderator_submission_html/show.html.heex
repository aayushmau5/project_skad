<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <div class="review-workspace">
    <.review_queue
      submissions={@queue_submissions}
      next_cursor={@queue_next_cursor}
      selected={@submission.public_id}
      cursor={@queue_after}
    />
    <article id="moderator-submission-detail">
      <p>
        <.link href={~p"/moderator/submissions?#{queue_query(@queue_after)}"}>{gettext(
          "Back to submission queue"
        )}</.link>
      </p>

      <header class="entry-header">
        <h1>{payload_value(@submission, "primary_form") || gettext("Submission")}</h1>
        <p class="result-meta" id="submission-status">
          {status_label(@submission.kind)} · {status_label(@submission.status)} · {format_time(
            @submission.received_at
          )}
        </p>
      </header>

      <.proposal :if={!@submission.reviewed_payload} submission={@submission} />

      <details
        :if={@submission.reviewed_payload}
        open
        id="original-submission-payload"
        class="entry-section"
      >
        <summary>{gettext("Original contributor proposal")}</summary>
        <dl>
          <dt>{gettext("Word or expression")}</dt>
          <dd>{original_payload_value(@submission, "primary_form")}</dd>
          <dt>{gettext("Language")}</dt>
          <dd>{original_payload_value(@submission, "language_slug")}</dd>
          <dt>{gettext("Meaning")}</dt>
          <dd>{original_payload_value(@submission, "definition")}</dd>
          <dt>{gettext("Part of speech")}</dt>
          <dd>{original_payload_value(@submission, "part_of_speech") || "—"}</dd>
          <dt>{gettext("Usage note")}</dt>
          <dd>{original_payload_value(@submission, "usage_note") || "—"}</dd>
          <dt>{gettext("Cultural context")}</dt>
          <dd>{original_payload_value(@submission, "cultural_note") || "—"}</dd>
          <dt>{gettext("Example")}</dt>
          <dd>{original_payload_value(@submission, "example") || "—"}</dd>
        </dl>
      </details>

      <section
        :if={
          @submission.kind in [:new_entry, :audio, :image] and
            (@media_items != [] or @submission.status in [:pending, :reviewing])
        }
        id="submission-media"
        class="entry-section media-uploader"
        data-media-uploader
        data-prepare-url={~p"/media/uploads"}
        data-complete-url={~p"/media/uploads/complete"}
        data-attach-url={~p"/moderator/submissions/#{@submission.public_id}/media"}
        data-max-images="5"
      >
        <h2>
          {case @submission.kind do
            :audio -> gettext("Pronunciation audio")
            :image -> gettext("Cultural images")
            :new_entry -> gettext("Pronunciation and cultural images")
          end}
        </h2>
        <p :if={@media_items == []} id="submission-media-empty">
          {gettext("No media attached.")}
        </p>

        <ul id="submission-media-list" class="media-list" data-media-list>
          <li
            :for={item <- @media_items}
            id={"submission-media-#{item.public_id}"}
            class="media-card"
            data-media-item
            data-kind={item.kind}
          >
            <audio
              :if={item.kind == :audio}
              id={"submission-audio-#{item.public_id}"}
              controls
              aria-label={gettext("Submitted pronunciation")}
              preload="none"
              src={
                ~p"/moderator/submissions/#{@submission.public_id}/media/#{item.public_id}/preview"
              }
            ></audio>
            <img
              :if={item.kind == :image}
              id={"submission-image-#{item.public_id}"}
              src={
                ~p"/moderator/submissions/#{@submission.public_id}/media/#{item.public_id}/preview"
              }
              alt={gettext("Submitted cultural context")}
              loading="lazy"
            />
            <p class="result-meta">{status_label(item.processing_state)}</p>
            <p>
              {Enum.join(
                Enum.reject(
                  [item.variety_label, item.place_label, item.attribution_text],
                  &is_nil/1
                ),
                " · "
              )}
            </p>
            <p>
              {gettext("Public-use permission is not recorded. Verify it before publication.")}
            </p>
            <.link
              :if={@submission.status in [:pending, :reviewing]}
              href={
                ~p"/moderator/submissions/#{@submission.public_id}/media/#{item.public_id}?#{queue_query(@queue_after)}"
              }
              method="delete"
              id={"remove-submission-media-#{item.public_id}"}
              class="link-button"
            >
              {gettext("Remove")}
            </.link>
          </li>
        </ul>

        <p
          :if={not media_approvable?(@submission, @media_items)}
          id="submission-media-processing"
          role="alert"
        >
          {gettext(
            "Attached media must finish processing before this submission can be approved."
          )}
        </p>

        <details :if={@submission.status in [:pending, :reviewing]} id="moderator-media-edit">
          <summary>{gettext("Replace or add media")}</summary>
          <div class="media-controls">
            <.input
              :if={@submission.kind in [:new_entry, :audio]}
              type="file"
              name="moderator_audio_upload"
              id="moderator-audio-upload"
              value={nil}
              label={
                if Enum.any?(@media_items, &(&1.kind == :audio)),
                  do: gettext("Replace pronunciation audio"),
                  else: gettext("Upload pronunciation audio")
              }
              accept="audio/*"
              class="auth-input"
              data-audio-input
            />
            <button
              :if={@submission.kind in [:new_entry, :audio]}
              type="button"
              id="record-moderator-audio"
              class="secondary-button"
              data-record-audio
            >
              {if Enum.any?(@media_items, &(&1.kind == :audio)),
                do: gettext("Record replacement"),
                else: gettext("Record pronunciation")}
            </button>
            <.input
              :if={@submission.kind in [:new_entry, :image]}
              type="file"
              name="moderator_image_uploads"
              id="moderator-image-uploads"
              value={nil}
              label={gettext("Add cultural images")}
              accept="image/jpeg,image/png,image/webp"
              multiple
              class="auth-input"
              data-image-input
            />
          </div>
        </details>
        <p id="moderator-media-status" class="result-meta" role="status" data-upload-status></p>
      </section>

      <section :if={@target_entry} id="submission-target" class="entry-section">
        <h2>{gettext("Current published entry")}</h2>
        <p>
          <.link href={~p"/entries/#{@target_entry.public_id}"}>
            {SkadWeb.PageHTML.primary_form_text(@target_entry)}
          </.link>
        </p>
        <p>{SkadWeb.PageHTML.first_definition(@target_entry)}</p>
      </section>

      <.proposal :if={@submission.reviewed_payload} submission={@submission} />

      <details
        :if={
          @submission.kind in [:new_entry, :correction, :addition, :example] and
            @submission.status in [:pending, :reviewing]
        }
        id="submission-edit"
        open={@edit_form && @edit_form.errors != []}
        class="entry-section auth-panel"
      >
        <summary>{gettext("Edit proposal")}</summary>
        <.form
          for={@edit_form}
          action={
            ~p"/moderator/submissions/#{@submission.public_id}/proposal?#{queue_query(@queue_after)}"
          }
          method="patch"
          id="proposal-edit-form"
          class="auth-form"
        >
          <.form_errors form={@edit_form} id="proposal-edit-errors" />
          <%= cond do %>
            <% @submission.kind == :addition -> %>
              <.input
                field={@edit_form[:alternate_form]}
                type="text"
                label={gettext("Alternate form")}
                class="auth-input"
              />
              <.input
                field={@edit_form[:form_kind]}
                type="select"
                label={gettext("Form type")}
                class="auth-input"
                options={[
                  {gettext("Alias"), :alias},
                  {gettext("Spelling"), :spelling},
                  {gettext("Transliteration"), :transliteration},
                  {gettext("Historical"), :historical}
                ]}
              />
              <.input
                field={@edit_form[:example]}
                type="textarea"
                label={gettext("Example sentence")}
                class="auth-input"
                rows="3"
              />
            <% @submission.kind == :example -> %>
              <.input
                field={@edit_form[:example]}
                type="textarea"
                label={gettext("Example sentence")}
                class="auth-input"
                rows="3"
                required
              />
            <% true -> %>
              <.input
                :if={@submission.kind == :new_entry}
                field={@edit_form[:language_slug]}
                type="select"
                label={gettext("Language")}
                class="auth-input"
                options={Enum.map(@languages, &{&1.name, &1.slug})}
                required
              />
              <.input
                field={@edit_form[:primary_form]}
                type="text"
                label={gettext("Word or expression")}
                class="auth-input"
                required
              />
              <.input
                field={@edit_form[:definition]}
                type="textarea"
                label={gettext("Meaning")}
                class="auth-input"
                rows="4"
                required
              />
              <.input
                field={@edit_form[:part_of_speech]}
                type="text"
                label={gettext("Part of speech")}
                class="auth-input"
              />
              <.input
                field={@edit_form[:usage_note]}
                type="textarea"
                label={gettext("Usage note")}
                class="auth-input"
                rows="3"
              />
              <.input
                field={@edit_form[:cultural_note]}
                type="textarea"
                label={gettext("Cultural context")}
                class="auth-input"
                rows="3"
              />
              <.input
                :if={@submission.kind == :new_entry}
                field={@edit_form[:example]}
                type="textarea"
                label={gettext("Example sentence")}
                class="auth-input"
                rows="3"
              />
          <% end %>
          <button type="submit" id="save-proposal" class="auth-button">{gettext("Save changes")}</button>
        </.form>
      </details>

      <section
        :if={
          payload_value(@submission, "example") &&
            @submission.status in [:pending, :reviewing]
        }
        id="submission-example-links"
        class="entry-section"
      >
        <h2>{gettext("Example links")}</h2>
        <p
          phx-no-format
          id="submission-example-preview"
          lang={payload_value(@submission, "language_slug")}
        ><%= for segment <- example_segments(payload_value(@submission, "example"), @example_suggestions) do %><%= case segment do %><% {:text, text} -> %>{text}<% {:match, suggestion} -> %><mark id={"example-match-#{suggestion.start_offset}"}>{suggestion.surface_text}</mark><% end %><% end %></p>

        <p :if={@example_match_error} id="example-match-error" role="alert">
          {@example_match_error}
        </p>
        <p
          :if={
            is_nil(@example_match_error) &&
              not Enum.any?(@example_suggestions, &(&1.role == :focus))
          }
          id="example-focus-missing"
          role="alert"
        >
          {gettext(
            "The example must contain the proposed word. Edit the sentence before approving."
          )}
        </p>

        <ol :if={@example_suggestions != []} id="example-suggestions" class="result-list">
          <li
            :for={{suggestion, index} <- Enum.with_index(@example_suggestions)}
            id={"example-suggestion-#{index}"}
            class="result-card"
          >
            <%= if suggestion.role == :focus do %>
              <strong>{suggestion.surface_text}</strong>
              <span id={"example-focus-#{index}"}>
                — {if @submission.kind == :new_entry,
                  do: gettext("proposed entry"),
                  else: gettext("target entry")}
              </span>
            <% else %>
              <.input
                type="select"
                id={"example-choice-#{index}"}
                name={"moderation[example_choices][#{index}]"}
                label={gettext("Link “%{word}” to", word: suggestion.surface_text)}
                prompt={gettext("Do not link")}
                options={example_candidate_options(suggestion)}
                value={Map.get(@example_choices, Integer.to_string(index), "")}
                class="auth-input"
                form="moderation-form"
              />
            <% end %>
          </li>
        </ol>
      </section>

      <section
        :if={@submission.kind == :new_entry and @submission.status in [:pending, :reviewing]}
        id="submission-concept"
        class="entry-section auth-panel"
      >
        <h2>{gettext("Concept")}</h2>
        <.form
          for={@concept_search_form}
          action={
            ~p"/moderator/submissions/#{@submission.public_id}?#{queue_query(@queue_after)}"
          }
          method="get"
          id="submission-concept-search-form"
          class="auth-form"
        >
          <.input
            field={@concept_search_form[:query]}
            type="search"
            label={gettext("Find an existing concept by concept or entry")}
            class="auth-input"
          />
          <button type="submit" id="search-submission-concepts" class="auth-button">
            {gettext("Search concepts")}
          </button>
        </.form>
        <p>
          {gettext(
            "Select a result during approval, or leave the selection blank to create a new concept."
          )}
        </p>
      </section>

      <section id="submission-review-history" class="entry-section">
        <h2>{gettext("Review history")}</h2>
        <p :if={@submission.review_history == []} id="empty-review-history">
          {gettext("No decisions yet.")}
        </p>
        <ol :if={@submission.review_history != []}>
          <li
            :for={{event, index} <- Enum.with_index(@submission.review_history)}
            id={"review-event-#{index}"}
          >
            <strong>{status_label(event["status"] || event["action"])}</strong>
            <span> · {event["reviewed_at"]}</span>
            <p :if={event["note"]}>{event["note"]}</p>
            <p :if={event["changed_fields"]}>
              {gettext("Changed:")} {Enum.join(event["changed_fields"], ", ")}
            </p>
          </li>
        </ol>
      </section>

      <section
        :if={@submission.status in [:pending, :reviewing]}
        id="submission-moderation"
        class="entry-section auth-panel"
      >
        <h2>{gettext("Decision")}</h2>
        <.form
          for={@form}
          action={
            ~p"/moderator/submissions/#{@submission.public_id}?#{queue_query(@queue_after)}"
          }
          method="patch"
          id="moderation-form"
          class="auth-form"
        >
          <%= if @submission.kind == :new_entry do %>
            <.input field={@form[:concept_query]} type="hidden" />
            <.input
              field={@form[:concept_public_id]}
              type="select"
              id="submission-concept-choice"
              label={gettext("Existing concept")}
              prompt={gettext("Create a new concept")}
              options={concept_candidate_options(@concept_candidates)}
              class="auth-input"
            />
            <.input
              field={@form[:concept_editorial_label]}
              type="text"
              label={gettext("New concept label (used only when creating)")}
              class="auth-input"
            />
            <.input
              field={@form[:concept_editorial_note]}
              type="textarea"
              label={gettext("New concept private note (used only when creating)")}
              class="auth-input"
              rows="3"
            />
          <% end %>
          <.input
            field={@form[:note]}
            type="textarea"
            label={gettext("Moderator note")}
            class="auth-input"
            rows="4"
          />

          <button
            :if={@submission.status == :pending}
            type="submit"
            id="start-review"
            name="moderation[decision]"
            value="reviewing"
            class="auth-button"
          >
            {gettext("Start review")}
          </button>
          <button
            :if={@submission.status in [:pending, :reviewing]}
            type="submit"
            id="approve-submission"
            name="moderation[decision]"
            value="approve"
            class="auth-button"
            disabled={
              not media_approvable?(@submission, @media_items) or
                not example_approvable?(
                  @submission,
                  @example_suggestions,
                  @example_match_error
                )
            }
          >
            {gettext("Approve and publish")}
          </button>
        </.form>
        <details id="rejection-controls" open={@form[:decision].value == "rejected"}>
          <summary>{gettext("Reject this contribution")}</summary>
          <.form
            for={@form}
            action={
              ~p"/moderator/submissions/#{@submission.public_id}?#{queue_query(@queue_after)}"
            }
            method="patch"
            id="rejection-form"
            class="auth-form"
          >
            <.input
              field={@form[:note]}
              id="rejection-reason"
              type="textarea"
              label={gettext("Reason for rejection")}
              class="auth-input"
              required
              rows="3"
            />
            <.input
              field={@form[:confirm_rejection]}
              id="confirm-rejection"
              type="checkbox"
              label={gettext("I confirm this contribution should not be published.")}
              required
            />
            <button
              type="submit"
              id="reject-submission"
              name="moderation[decision]"
              value="rejected"
              class="auth-button danger-button"
            >{gettext("Confirm rejection")}</button>
          </.form>
        </details>
      </section>
    </article>
  </div>
</Layouts.app>
