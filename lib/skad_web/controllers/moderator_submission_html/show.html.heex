<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article id="moderator-submission-detail">
    <p><.link href={~p"/moderator/submissions"}>Back to submission queue</.link></p>

    <header class="entry-header">
      <h1>{payload_value(@submission, "primary_form") || "Submission"}</h1>
      <p class="result-meta" id="submission-status">{status_label(@submission.status)}</p>
    </header>

    <section id="submission-payload" class="entry-section">
      <h2>{if @submission.reviewed_payload, do: "Reviewed proposal", else: "Proposal"}</h2>
      <dl>
        <dt>Kind</dt>
        <dd>{status_label(@submission.kind)}</dd>
        <dt>Language</dt>
        <dd id="submission-language">{payload_value(@submission, "language_slug")}</dd>
        <dt>Meaning</dt>
        <dd id="submission-definition">{payload_value(@submission, "definition")}</dd>
        <dt>Part of speech</dt>
        <dd>{payload_value(@submission, "part_of_speech") || "—"}</dd>
        <dt>Usage note</dt>
        <dd>{payload_value(@submission, "usage_note") || "—"}</dd>
        <dt>Cultural context</dt>
        <dd>{payload_value(@submission, "cultural_note") || "—"}</dd>
        <dt>Example</dt>
        <dd id="submission-example">{payload_value(@submission, "example") || "—"}</dd>
        <dt>Received</dt>
        <dd>{format_time(@submission.received_at)}</dd>
        <dt>Receipt</dt>
        <dd><code>{@submission.public_id}</code></dd>
      </dl>
    </section>

    <details
      :if={@submission.reviewed_payload}
      id="original-submission-payload"
      class="entry-section"
    >
      <summary>Original contributor proposal</summary>
      <dl>
        <dt>Word or expression</dt>
        <dd>{original_payload_value(@submission, "primary_form")}</dd>
        <dt>Language</dt>
        <dd>{original_payload_value(@submission, "language_slug")}</dd>
        <dt>Meaning</dt>
        <dd>{original_payload_value(@submission, "definition")}</dd>
        <dt>Part of speech</dt>
        <dd>{original_payload_value(@submission, "part_of_speech") || "—"}</dd>
        <dt>Usage note</dt>
        <dd>{original_payload_value(@submission, "usage_note") || "—"}</dd>
        <dt>Cultural context</dt>
        <dd>{original_payload_value(@submission, "cultural_note") || "—"}</dd>
        <dt>Example</dt>
        <dd>{original_payload_value(@submission, "example") || "—"}</dd>
      </dl>
    </details>

    <section
      :if={@submission.status in [:pending, :reviewing]}
      id="submission-edit"
      class="entry-section auth-panel"
    >
      <h2>Edit proposal</h2>
      <.form
        for={@edit_form}
        action={~p"/moderator/submissions/#{@submission.public_id}/proposal"}
        method="patch"
        id="proposal-edit-form"
        class="auth-form"
      >
        <.input
          field={@edit_form[:language_slug]}
          type="select"
          label="Language"
          class="auth-input"
          options={Enum.map(@languages, &{&1.name, &1.slug})}
          required
        />
        <.input
          field={@edit_form[:primary_form]}
          type="text"
          label="Word or expression"
          class="auth-input"
          required
        />
        <.input
          field={@edit_form[:definition]}
          type="textarea"
          label="Meaning"
          class="auth-input"
          rows="4"
          required
        />
        <.input
          field={@edit_form[:part_of_speech]}
          type="text"
          label="Part of speech"
          class="auth-input"
        />
        <.input
          field={@edit_form[:usage_note]}
          type="textarea"
          label="Usage note"
          class="auth-input"
          rows="3"
        />
        <.input
          field={@edit_form[:cultural_note]}
          type="textarea"
          label="Cultural context"
          class="auth-input"
          rows="3"
        />
        <.input
          field={@edit_form[:example]}
          type="textarea"
          label="Example sentence"
          class="auth-input"
          rows="3"
        />
        <button type="submit" id="save-proposal" class="auth-button">Save changes</button>
      </.form>
    </section>

    <section
      :if={
        payload_value(@submission, "example") &&
          @submission.status in [:pending, :reviewing]
      }
      id="submission-example-links"
      class="entry-section"
    >
      <h2>Example links</h2>
      <p
        phx-no-format
        id="submission-example-preview"
        lang={payload_value(@submission, "language_slug")}
      ><%= for segment <- example_segments(payload_value(@submission, "example"), @example_suggestions) do %><%= case segment do %><% {:text, text} -> %>{text}<% {:match, suggestion} -> %><mark id={"example-match-#{suggestion.start_offset}"}>{suggestion.surface_text}</mark><% end %><% end %></p>

      <p :if={@example_match_error} id="example-match-error" role="alert">
        {@example_match_error}
      </p>
      <p
        :if={
          is_nil(@example_match_error) &&
            not Enum.any?(@example_suggestions, &(&1.role == :focus))
        }
        id="example-focus-missing"
        role="alert"
      >
        The example must contain the proposed word. Edit the sentence before approving.
      </p>

      <ol :if={@example_suggestions != []} id="example-suggestions" class="result-list">
        <li
          :for={{suggestion, index} <- Enum.with_index(@example_suggestions)}
          id={"example-suggestion-#{index}"}
          class="result-card"
        >
          <%= if suggestion.role == :focus do %>
            <strong>{suggestion.surface_text}</strong>
            <span id={"example-focus-#{index}"}> — proposed entry</span>
          <% else %>
            <.input
              type="select"
              id={"example-choice-#{index}"}
              name={"moderation[example_choices][#{index}]"}
              label={"Link “#{suggestion.surface_text}” to"}
              prompt="Do not link"
              options={example_candidate_options(suggestion)}
              value={Map.get(@example_choices, Integer.to_string(index), "")}
              class="auth-input"
              form="moderation-form"
            />
          <% end %>
        </li>
      </ol>
    </section>

    <section id="submission-review-history" class="entry-section">
      <h2>Review history</h2>
      <p :if={@submission.review_history == []} id="empty-review-history">No decisions yet.</p>
      <ol :if={@submission.review_history != []}>
        <li
          :for={{event, index} <- Enum.with_index(@submission.review_history)}
          id={"review-event-#{index}"}
        >
          <strong>{status_label(event["status"] || event["action"])}</strong>
          <span> · {event["reviewed_at"]}</span>
          <p :if={event["note"]}>{event["note"]}</p>
          <p :if={event["changed_fields"]}>
            Changed: {Enum.join(event["changed_fields"], ", ")}
          </p>
        </li>
      </ol>
    </section>

    <section
      :if={@submission.status in [:pending, :reviewing]}
      id="submission-moderation"
      class="entry-section auth-panel"
    >
      <h2>Decision</h2>
      <.form
        for={@form}
        action={~p"/moderator/submissions/#{@submission.public_id}"}
        method="patch"
        id="moderation-form"
        class="auth-form"
      >
        <.input
          field={@form[:note]}
          type="textarea"
          label="Moderator note"
          class="auth-input"
          rows="4"
        />

        <button
          :if={@submission.status == :pending}
          type="submit"
          id="start-review"
          name="moderation[decision]"
          value="reviewing"
          class="auth-button"
        >
          Start review
        </button>
        <button
          :if={@submission.status in [:pending, :reviewing]}
          type="submit"
          id="approve-submission"
          name="moderation[decision]"
          value="approve"
          class="auth-button"
          disabled={
            not example_approvable?(
              @submission,
              @example_suggestions,
              @example_match_error
            )
          }
        >
          Approve and publish
        </button>
        <button
          type="submit"
          id="reject-submission"
          name="moderation[decision]"
          value="rejected"
          class="auth-button"
        >
          Reject
        </button>
      </.form>
    </section>
  </article>
</Layouts.app>
