<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <div class="review-workspace">
    <.review_queue submissions={@submissions} next_cursor={@next_cursor} cursor={@queue_after} />
    <section id="review-queue-intro">
      <h1>{gettext("Choose a contribution to review")}</h1>
      <p>
        {gettext("Compare the proposal with published content, check its context, then decide.")}
      </p>
    </section>
  </div>
</Layouts.app>
