<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <section id="contribution-receipt" class="auth-panel">
    <h1 class="trust-note">{gettext("Suggestion received")}</h1>
    <p>
      {gettext("Your suggestion has been saved. A moderator will review it before publication.")}
    </p>

    <p>{gettext("Keep this receipt link to check the review status.")}</p>
    <dl>
      <dt>{gettext("Status")}</dt>
      <dd id="contribution-status">{status_label(@receipt.status)}</dd>
      <dt>{gettext("Receipt")}</dt>
      <dd><code id="contribution-receipt-id">{@receipt.public_id}</code></dd>
    </dl>

    <p><.link href={~p"/"}>{gettext("Return to the archive")}</.link></p>
  </section>
</Layouts.app>
