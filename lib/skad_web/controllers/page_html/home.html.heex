<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
  entry_count={@entry_count}
>
  <:footer_invitation>
    <section
      id="search-contribution"
      class="footer-invitation"
      aria-labelledby="search-contribution-heading"
    >
      <h2 id="search-contribution-heading">{gettext("Help keep these languages alive")}</h2>
      <p>{gettext("Share a word you know. You don’t need an account.")}</p>
      <.link id="suggest-new-word" href={~p"/contribute"}>{gettext("Suggest a word")}</.link>
    </section>
  </:footer_invitation>
  <section class="page-intro" aria-labelledby="search-heading">
    <h1 id="search-heading">{gettext("What word are you looking for?")}</h1>
    <p>{gettext("Find a word, a spelling, or a meaning in Kinnaur’s languages.")}</p>
  </section>

  <.form
    for={@search_form}
    action={~p"/"}
    method="get"
    id="archive-search"
    class="search-form"
    role="search"
    data-live-search
    data-results-url={~p"/search/results"}
    data-searching={gettext("Searching…")}
    data-results-ready={gettext("Results updated.")}
    data-no-results={gettext("No matches yet.")}
    data-search-error={
      gettext("Results could not update. Check your connection, then press Search to try again.")
    }
  >
    <div class="search-fields">
      <.input
        field={@search_form[:q]}
        type="search"
        label={gettext("Word or meaning")}
        class="search-input"
        placeholder={gettext("Try a word or meaning")}
        aria-describedby="search-help"
        maxlength="120"
        required
      />
      <.language_chips
        field={@search_form[:language]}
        label={gettext("Narrow by language (optional)")}
        languages={@languages}
        include_all
      />
      <button type="submit" id="search-submit" class="search-button">{gettext("Search")}</button>
    </div>
    <p id="search-help" class="help-text">
      {gettext("You can also try a different spelling or transliteration.")}
    </p>
  </.form>

  <p id="search-status" class="search-status help-text" role="status" hidden></p>
  <div id="search-output" aria-busy="false">
    <.search_results :if={@searched?} results={@results} languages={@languages} />
  </div>

  <section
    :if={@recent_entries != []}
    id="recent-words"
    class="entry-section"
    aria-labelledby="recent-words-heading"
    hidden={@searched?}
  >
    <div class="workspace-heading">
      <h2 id="recent-words-heading">{gettext("Recently added")}</h2>
      <.link id="recent-words-archive" href={archive_path(nil, 1, @locale)}>
        {gettext("View all words")}
      </.link>
    </div>
    <ol id="recent-word-list" class="recent-word-list">
      <li
        :for={entry <- @recent_entries}
        id={"recent-word-#{entry.public_id}"}
        class="result-card recent-word-card"
      >
        <h3>
          <.link
            href={~p"/entries/#{entry.public_id}"}
            class="result-link"
            lang={entry.language.code || entry.language.slug}
            dir={to_string(entry.language.direction)}
          >{primary_form_text(entry)}</.link>
        </h3>
        <p class="result-meta">{language_label(entry.language)}</p>
        <p :if={first_definition(entry)} lang={definition_language(entry, @languages)} dir="auto">
          {first_definition(entry)}
        </p>
      </li>
    </ol>
  </section>
</Layouts.app>
