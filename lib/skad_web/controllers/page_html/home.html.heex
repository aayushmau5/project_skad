<Layouts.app flash={@flash}>
  <section class="page-intro">
    <h1>Search the archive</h1>
    <p>Find words, meanings, alternate forms, and examples across Kinnaur's languages.</p>
  </section>

  <.form for={@search_form} action={~p"/"} method="get" id="archive-search" class="search-form">
    <.input
      field={@search_form[:q]}
      type="search"
      label="Word or meaning"
      class="search-input"
      placeholder="Try a word, spelling, or meaning"
      required
    />
    <.input
      field={@search_form[:language]}
      type="select"
      label="Language"
      class="search-select"
      prompt="All languages"
      options={Enum.map(@languages, &{&1.name, &1.slug})}
    />
    <button type="submit" id="search-submit" class="search-button">Search</button>
  </.form>

  <section :if={@searched?} id="search-results" class="search-results" aria-live="polite">
    <h2>Results</h2>

    <p :if={@results == []} id="no-search-results">No entries found.</p>

    <ol :if={@results != []} class="result-list">
      <li
        :for={result <- @results}
        id={"search-result-#{result.entry.public_id}"}
        class="result-card"
      >
        <.link href={~p"/entries/#{result.entry.public_id}"} class="result-link">
          {primary_form_text(result.entry)}
        </.link>
        <p class="result-meta">{result.entry.language.name}</p>
        <p :if={first_definition(result.entry)}>{first_definition(result.entry)}</p>
        <p :if={result.matched_form && !result.matched_form.is_primary} class="result-meta">
          Matched form: {result.matched_form.text}
        </p>
      </li>
    </ol>
  </section>
</Layouts.app>
