<p :if={@entry.part_of_speech || @entry.variety_label || @entry.place_label} class="result-meta">
  {Enum.join(
    Enum.reject([@entry.part_of_speech, @entry.variety_label, @entry.place_label], &is_nil/1),
    " · "
  )}
</p>
<section
  id={meaning_dom_id("entry-definitions", @entry, @selected_id)}
  class="meaning-definitions"
  aria-labelledby={"meaning-heading-#{@entry.public_id}"}
>
  <p
    :for={definition <- @entry.definitions}
    lang={content_language(definition.language, @languages)}
    data-language={definition.language}
    dir="auto"
  >
    {definition.text}
  </p>
  <p :if={@entry.definitions == []}>{gettext("The meaning has not been recorded yet.")}</p>
</section>
<.pronunciation
  :if={not @compact?}
  entry={@entry}
  audio={@audio}
  selected_id={@selected_id}
/>
<section
  :if={examples(@entry) != []}
  id={meaning_dom_id("entry-examples", @entry, @selected_id)}
  class={["entry-section", "meaning-examples"]}
>
  <h3 :if={not @compact?}>{gettext("Examples")}</h3>
  <article
    :for={example <- examples(@entry)}
    id={meaning_dom_id("example-#{example.public_id}", @entry, @selected_id)}
  >
    <p
      phx-no-format
      lang={example.language.code || example.language.slug}
      dir={to_string(example.language.direction)}
    ><%= for segment <- text_segments(example.text, example.links) do %><%= case segment do %><% {:text, text} -> %>{text}<% {:match, link} -> %><.link id={meaning_dom_id("example-link-#{example.public_id}-#{link.id}", @entry, @selected_id)} href={meaning_path(link.entry)}>{link.surface_text}</.link><% end %><% end %></p>
    <p
      :for={translation <- example.translations}
      lang={content_language(translation.language, @languages)}
      data-language={translation.language}
      dir="auto"
    >
      {translation.text}
    </p>
  </article>
</section>
<.pronunciation
  :if={@compact?}
  entry={@entry}
  audio={@audio}
  selected_id={@selected_id}
/>
<section
  :if={@entry.usage_note}
  id={meaning_dom_id("entry-usage-note", @entry, @selected_id)}
  class="entry-section"
>
  <h3>{gettext("Usage")}</h3>
  <p
    lang={@entry.language.code || @entry.language.slug}
    dir={to_string(@entry.language.direction)}
  >
    {@entry.usage_note}
  </p>
</section>
<section
  :if={@entry.cultural_note || @images != []}
  id={meaning_dom_id("entry-cultural-note", @entry, @selected_id)}
  class="entry-section"
>
  <h3>{gettext("Cultural context")}</h3>
  <p
    :if={@entry.cultural_note}
    lang={@entry.language.code || @entry.language.slug}
    dir={to_string(@entry.language.direction)}
  >
    {@entry.cultural_note}
  </p>
  <div
    :if={@images != []}
    id={meaning_dom_id("entry-images", @entry, @selected_id)}
    class="media-gallery"
  >
    <figure
      :for={image <- @images}
      id={meaning_dom_id("entry-image-#{image.public_id}", @entry, @selected_id)}
      class="media-figure"
    >
      <img
        src={~p"/media/#{image.public_id}"}
        alt={gettext("Cultural context for %{word}", word: primary_form_text(@entry))}
        loading="lazy"
      />
      <figcaption :if={image.attribution_text}>{image.attribution_text}</figcaption>
    </figure>
  </div>
</section>
<section id={meaning_dom_id("entry-forms", @entry, @selected_id)} class="entry-section">
  <h3>{gettext("Other forms and spellings")}</h3>
  <ul>
    <li :for={form <- @entry.forms} id={"entry-form-#{form.id}"}>
      <span
        lang={@entry.language.code || @entry.language.slug}
        dir={to_string(@entry.language.direction)}
      >{form.text}</span> <small>({form_label(form.kind)})</small>
    </li>
  </ul>
</section>
<section
  :if={equivalent_entries(@entry) != []}
  id={meaning_dom_id("entry-equivalents", @entry, @selected_id)}
  class="entry-section"
>
  <h3>{gettext("Other languages")}</h3>
  <ul>
    <li
      :for={equivalent <- equivalent_entries(@entry)}
      id={meaning_dom_id("equivalent-entry-#{equivalent.public_id}", @entry, @selected_id)}
    >
      <.link href={meaning_path(equivalent)}><span
        lang={equivalent.language.code || equivalent.language.slug}
        dir={to_string(equivalent.language.direction)}
      >{primary_form_text(equivalent)}</span>
      — {language_label(equivalent.language)}</.link>
    </li>
  </ul>
</section>
<section id={meaning_dom_id("entry-review", @entry, @selected_id)} class="entry-section">
  <h3>{gettext("About this record")}</h3>
  <p class="trust-note">{gettext("Published in the community archive")}</p>
  <p class="help-text">
    {gettext("Detailed source and review information is not available here.")}
  </p>
  <p class="help-text">
    {gettext("Local forms and pronunciations may vary. Share another form of this word.")}
  </p>
</section>
<section id={meaning_dom_id("entry-contributions", @entry, @selected_id)} class="entry-section">
  <h3>{gettext("Share what you know")}</h3>
  <ul class="contribution-actions">
    <li>
      <.link
        id={meaning_dom_id("suggest-entry-correction", @entry, @selected_id)}
        href={~p"/entries/#{@entry.public_id}/correct"}
      >{gettext("Suggest a correction")}</.link>
    </li>
    <li>
      <.link
        id={meaning_dom_id("suggest-entry-addition", @entry, @selected_id)}
        href={~p"/entries/#{@entry.public_id}/add"}
      >{gettext("Add another form")}</.link>
    </li>
    <li>
      <.link
        id={meaning_dom_id("suggest-entry-example", @entry, @selected_id)}
        href={~p"/entries/#{@entry.public_id}/examples/new"}
      >{gettext("Add an example")}</.link>
    </li>
    <li>
      <.link
        id={meaning_dom_id("suggest-entry-images", @entry, @selected_id)}
        href={~p"/entries/#{@entry.public_id}/images/new"}
      >{gettext("Add images")}</.link>
    </li>
  </ul>
</section>
