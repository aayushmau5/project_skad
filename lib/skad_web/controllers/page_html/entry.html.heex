<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <article id="entry-page">
    <p><.link href={~p"/"}>{gettext("Back to search")}</.link></p>
    <header class="entry-header">
      <h1
        id="entry-title"
        lang={@entry.language.code || @entry.language.slug}
        dir={to_string(@entry.language.direction)}
      >
        {primary_form_text(@entry)}
      </h1>
      <p class="result-meta">{language_label(@entry.language)}</p>
    </header>
    <div id="entry-meanings">
      <section
        :for={{meaning, index} <- Enum.with_index(@meanings, 1)}
        id={"meaning-#{meaning.entry.public_id}"}
        class={["word-meaning", length(@meanings) > 1 && "word-meaning-compact"]}
        data-selected={to_string(meaning.entry.id == @entry.id)}
        aria-labelledby={"meaning-heading-#{meaning.entry.public_id}"}
      >
        <h2 id={"meaning-heading-#{meaning.entry.public_id}"}>
          <%= if length(@meanings) > 1 do %>
            <.link
              href={"#meaning-#{meaning.entry.public_id}"}
              aria-label={gettext("Meaning %{number}", number: index)}
            >{index}.</.link>
          <% else %>
            {gettext("Meaning")}
          <% end %>
        </h2>
        <div class="meaning-content">
          <.meaning
            entry={meaning.entry}
            audio={meaning.audio}
            images={meaning.images}
            languages={@languages}
            selected_id={@entry.id}
            compact?={length(@meanings) > 1}
          />
        </div>
      </section>
    </div>
    <p>
      <.link id="suggest-another-meaning" href={~p"/entries/#{@entry.public_id}/meanings/new"}>{gettext(
        "Add another meaning"
      )}</.link>
    </p>
  </article>
</Layouts.app>
