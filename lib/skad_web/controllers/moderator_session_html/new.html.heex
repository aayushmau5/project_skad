<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="moderator-login" class="auth-panel">
    <h1>Moderator log in</h1>

    <.form for={@form} action={~p"/moderator/log-in"} id="moderator-login-form" class="auth-form">
      <.input
        field={@form[:email]}
        type="email"
        label="Email"
        class="auth-input"
        autocomplete="username"
        required
      />
      <.input
        field={@form[:password]}
        type="password"
        label="Password"
        class="auth-input"
        autocomplete="current-password"
        required
      />
      <button type="submit" id="moderator-login-submit" class="auth-button">Log in</button>
    </.form>
  </section>
</Layouts.app>
