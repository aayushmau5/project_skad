<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <section id="moderator-login">
    <header class="entry-header">
      <h1>{gettext("Moderator log in")}</h1>
      <p class="help-text">
        {gettext("Log in to review contributions and manage published words.")}
      </p>
    </header>

    <.form
      for={@form}
      action={~p"/moderator/log-in"}
      id="moderator-login-form"
      class="auth-form entry-section"
    >
      <.input
        field={@form[:email]}
        type="email"
        label={gettext("Email")}
        class="auth-input"
        autocomplete="username"
        required
      />
      <.input
        field={@form[:password]}
        type="password"
        label={gettext("Password")}
        class="auth-input"
        autocomplete="current-password"
        required
      />
      <button type="submit" id="moderator-login-submit" class="auth-button">{gettext("Log in")}</button>
    </.form>
  </section>
</Layouts.app>
