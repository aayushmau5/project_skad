<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="moderator-home">
    <h1>Moderator workspace</h1>
    <p>
      Signed in as <strong id="moderator-display-name">{@current_scope.moderator_account.display_name}</strong>.
    </p>
    <p>
      <.link id="moderator-submissions-link" href={~p"/moderator/submissions"}>Review submissions</.link>
    </p>
    <p>
      <.link id="moderator-concepts-link" href={~p"/moderator/concepts"}>Manage concepts</.link>
    </p>
    <p>
      <.link id="moderator-dashboard-link" href={~p"/moderator/dashboard"}>System dashboard</.link>
    </p>
  </section>
</Layouts.app>
