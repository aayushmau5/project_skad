<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <section id="moderator-home">
    <header class="entry-header">
      <h1>{gettext("Moderator workspace")}</h1>
      <p class="help-text">
        {gettext("Signed in as")} <strong id="moderator-display-name">{@current_scope.moderator_account.display_name}</strong>.
      </p>
    </header>
    <ul id="moderator-workspace-actions" class="result-list">
      <li class="result-card">
        <h2>
          <.link id="moderator-submissions-link" href={~p"/moderator/submissions"}>{gettext(
            "Review submissions"
          )}</.link>
        </h2>
        <p class="help-text">
          {gettext("Review incoming suggestions before they are published.")}
        </p>
      </li>
      <li class="result-card">
        <h2>
          <.link id="moderator-concepts-link" href={~p"/moderator/concepts"}>{gettext(
            "Manage concepts"
          )}</.link>
        </h2>
        <p class="help-text">{gettext("Edit words, meanings, and links between languages.")}</p>
      </li>
      <li class="result-card">
        <h2>
          <.link id="moderator-dashboard-link" href={~p"/moderator/dashboard"}>{gettext(
            "System dashboard"
          )}</.link>
        </h2>
        <p class="help-text">{gettext("Check application health and performance.")}</p>
      </li>
    </ul>
  </section>
</Layouts.app>
