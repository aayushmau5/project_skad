<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  language_links={@language_links}
  moderator={@moderator_workspace?}
>
  <article id="moderator-concept-detail">
    <p><.link href={~p"/moderator/concepts"}>{gettext("Back to concepts")}</.link></p>

    <header class="entry-header">
      <h1 id="concept-label">{@concept.editorial_label}</h1>
      <p id="concept-note">{@concept.editorial_note || gettext("No notes yet.")}</p>
    </header>

    <section id="concept-entries" class="entry-section">
      <h2>{gettext("Entries")}</h2>
      <p :if={@concept.entries == []}>{gettext("No entries use this concept yet.")}</p>
      <ul :if={@concept.entries != []}>
        <li :for={entry <- @concept.entries} id={"concept-entry-#{entry.public_id}"}>
          <.link href={~p"/entries/#{entry.public_id}"}>{entry_label(entry)}</.link>
        </li>
      </ul>
    </section>

    <section
      id="concept-media"
      class="entry-section media-uploader"
      data-media-uploader
      data-prepare-url={~p"/moderator/concepts/#{@concept.public_id}/media/uploads"}
      data-complete-url={~p"/moderator/concepts/#{@concept.public_id}/media/uploads/complete"}
      data-reload-after-upload="true"
    >
      <h2>{gettext("Cultural images")}</h2>
      <p :if={@media_items == []} id="concept-media-empty">{gettext("No images attached.")}</p>
      <ul id="concept-media-list" class="media-list" data-media-list>
        <li
          :for={item <- @media_items}
          id={"concept-media-#{item.public_id}"}
          class="media-card"
          data-media-item
          data-kind="image"
        >
          <img
            src={~p"/moderator/concepts/#{@concept.public_id}/media/#{item.public_id}/preview"}
            alt={gettext("Concept cultural context")}
            loading="lazy"
          />
          <p class="result-meta">{item.processing_state}</p>
          <.link
            href={~p"/moderator/concepts/#{@concept.public_id}/media/#{item.public_id}"}
            method="delete"
            id={"remove-concept-media-#{item.public_id}"}
            class="link-button"
          >
            {gettext("Remove")}
          </.link>
        </li>
      </ul>
      <.input
        type="file"
        name="concept_image_uploads"
        id="concept-image-uploads"
        value={nil}
        label={gettext("Add cultural images")}
        accept="image/jpeg,image/png,image/webp"
        multiple
        class="auth-input"
        data-image-input
      />
      <p id="concept-media-status" class="result-meta" role="status" data-upload-status></p>
    </section>

    <section id="edit-concept" class="entry-section auth-panel">
      <h2>{gettext("Edit concept")}</h2>
      <.form
        for={@form}
        action={~p"/moderator/concepts/#{@concept.public_id}"}
        method="patch"
        id="edit-concept-form"
        class="auth-form"
      >
        <.input
          field={@form[:editorial_label]}
          type="text"
          label={gettext("Concept name")}
          class="auth-input"
          required
        />
        <.input
          field={@form[:editorial_note]}
          type="textarea"
          label={gettext("Notes")}
          description={gettext("Only moderators can see these notes.")}
          class="auth-input"
          rows="4"
        />
        <button type="submit" id="update-concept" class="auth-button">{gettext("Save concept")}</button>
      </.form>
    </section>
  </article>
</Layouts.app>
